{
  "model": {
    "type": "minecraft:select",
    "property": "minecraft:custom_model_data",
    "index": 0,
    "cases": [
      {
        "when": "stonebreaker",
        "model": {
          "type": "minecraft:model",
          "model": "wincors:item/stonebreaker"
        }
      },
      {
        "when": "bloodreaver",
        "model": {
          "type": "minecraft:model",
          "model": "wincors:item/bloodreaver"
        }
      }
    ],
    "fallback": {
      "type": "minecraft:model",
      "model": "minecraft:item/netherite_axe"
    }
  }
}